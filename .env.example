# Payload CMS
PAYLOAD_SECRET=
DATABASE_URI=
DATABASE_AUTH_TOKEN=

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=novaren

# Paystack: shortlet payments. Use sk_test_… while testing, sk_live_… in production.
# Webhook URL to set in the Paystack dashboard: https://<your-domain>/paystack/webhook
PAYSTACK_SECRET_KEY=

# Resend: booking confirmation emails.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Novaren Lifestyle <bookings@novarenlifestyle.cc>"
BOOKINGS_EMAIL_FROM=
# Where new-booking alerts go (defaults to novarenlifestyle@yahoo.com)
BOOKINGS_NOTIFY_EMAIL=
