# Payload CMS
PAYLOAD_SECRET=
DATABASE_URI=
DATABASE_AUTH_TOKEN=

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=novaren

# Online shortlet booking (/stays). Off in production until set to "true"
# (set it together with a live Paystack key, then redeploy). On in development.
STAYS_BOOKING_ENABLED=

# Paystack: shortlet payments. Use sk_test_… while testing, sk_live_… in production.
# Webhook URL to set in the Paystack dashboard: https://<your-domain>/paystack/webhook
PAYSTACK_SECRET_KEY=

# Resend: booking confirmation emails.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Novaren Lifestyle <hello@novarenlifestyle.cc>"
BOOKINGS_EMAIL_FROM=
# Where new-booking alerts go (defaults to hello@novarenlifestyle.cc)
BOOKINGS_NOTIFY_EMAIL=
# Comma-separated team addresses for new-enquiry alerts
# (defaults to novarenlifestyle@yahoo.com,hello@novarenlifestyle.cc)
INQUIRY_NOTIFY_EMAILS=
